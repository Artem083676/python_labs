with open('students.txt', 'r', encoding='utf-8') as file:
    student_list = []
    for line in file:
        line = line.strip()
        if not line:
            continue
        name, bal = line.split(';')
        bal = int(bal)
        if bal < 80:
            continue
        student_list.append((bal,name))
    student_list.sort(reverse=True)
    for bal, line in student_list:
        print(line,bal)


