students = ['Anna', 'Ivan', 'Artem', 'Matvey', 'Illia']
grades = {
    'алгебра': 10,
    'геометрія': 8,
    'фізика': 3,
    'інформатика': 1#співпадіня з реальністю - випадкове;)
}

bazannia = input('1 - учень, 2 - предмет: ').strip()
try:
    bazannia = int(bazannia)
    if bazannia != 1 and bazannia != 2:
        raise ValueError
    
    if bazannia == 1:
        index = input('Індекс: ')
        try:
            index = int(index)
            print(f'Учень: {students[index - 1]}')
        except ValueError:
            print('Ви ввели не ціле число.')
        except IndexError:
            print('Учня з таким індексом немає.')

    if bazannia == 2:
        predmet = input('Предмет: ').strip().lower()
        try:
            print(f'Оцінка: {grades[predmet]}')
        except KeyError:
            print('Такого предмету не існує!')
    
except ValueError:
    print('Введіть 1 або 2!!!')











