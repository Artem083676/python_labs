from datetime import *

a,b,c = input("Дата події: ").split()
a = int(a)
b = int(b)
c = int(c)
date1 = date(a,b,c)
date2 = date.today()
diffrence = (date2 - date1).days
if diffrence > 0:
    print(f'Минуло: {diffrence} днів')
elif diffrence < 0:
    diffrence = diffrence * -1
    print(f'До події залишилося: {diffrence} днів')
else:
    print("Подія сьогодні!")









