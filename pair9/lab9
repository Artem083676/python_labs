class Wallet:
    def __init__(self,owner,balance):
        print(f'{owner}: баланс {balance}')
        self.owner = owner
        self.balance = balance
    def deposite(self,amount):
        print(amount)
        if amount > 0:
            self.balance += amount
        else:
            print("Поповнення на нульову або від'ємну суму - неможливе")
    def withdraw(self,amount):
        print(amount)
        if amount < 0 and self.balance >= (amount * -1):
            self.balance += amount
        elif amount < 0 and self.balance < (amount * -1):
            print(f"Списання неможливе, бракує: {(amount * -1) - self.balance}")
        else:
            print('Списання додатньої суми неможливе')
    def info(self):
        print(f'{self.owner}: баланс {self.balance}')

